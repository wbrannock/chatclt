# this is an example .env file, use it to create your own .env file and place it in the root of the project

# settings for OpenAI-compatible chat APIs
# For ChatCLT, this usually points at OpenRouter.
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_API_KEY=<YOUR_OPENROUTER_KEY>
OPENAI_CHAT_MODEL=anthropic/claude-sonnet-4-6
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large

# settings for Cohere
COHERE_API_KEY=<COHERE_API_KEY>


# settings for local models served by Ollama (pull each tag first: `ollama pull <tag>`)
# gemma4:26b = Gemma 4 26B A4B, our eval models plus the small on-device gemma4:e4b
LOCAL_MODELS=gemma4:e4b,gemma4:26b,qwen3:14b,mistral-small3.2:24b
# make the first local model the app's default LLM
LOCAL_MODELS_DEFAULT=true
# context window for the "-32k" model variants
# LOCAL_MODEL_CTX=32768
# optional Ollama embeddings (FastEmbed is the local default; pull before enabling)
# LOCAL_MODEL_EMBEDDINGS=nomic-embed-text



# settings for PDF.js
PDFJS_VERSION_DIST="pdfjs-4.0.379-dist"
